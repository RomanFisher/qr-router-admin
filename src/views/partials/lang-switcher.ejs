<div class="flex items-center gap-1 text-xs">
  <% supportedLocales.forEach(function(code, i) { %><% if (i > 0) { %><span class="text-neutral-300 dark:text-neutral-700">·</span><% } %><a href="/set-locale/<%= code %>?redirect=<%= encodeURIComponent(currentPath) %>" class="px-0.5 <%= locale === code ? 'font-semibold text-indigo-600 dark:text-indigo-400' : 'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100' %>"><%= code.toUpperCase() %></a><% }); %>
</div>
