<!doctype html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : t('app.name') %></title>
  <script>
    (function () {
      var stored = localStorage.getItem('theme');
      var isDark = stored ? stored === 'dark' : true;
      document.documentElement.classList.toggle('dark', isDark);
    })();
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };

    function toggleTheme() {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }
  </script>
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
  <% if (typeof showNav === 'undefined' || showNav) { %>
  <nav class="border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-3">
      <a href="/admin" class="font-bold text-neutral-900 dark:text-neutral-100"><%= t('app.name') %></a>
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <a href="/admin" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"><%= t('nav.codes') %></a>
        <a href="/admin/settings" class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"><%= t('nav.settings') %></a>
        <form action="/logout" method="post">
          <button type="submit" class="text-neutral-500 underline-offset-2 hover:text-neutral-900 hover:underline dark:text-neutral-400 dark:hover:text-neutral-100"><%= t('nav.logout') %></button>
        </form>
        <%- include('lang-switcher') %>
        <%- include('theme-toggle') %>
      </div>
    </div>
  </nav>
  <% } else { %>
  <nav class="border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
      <span class="font-bold text-neutral-900 dark:text-neutral-100"><%= t('app.name') %></span>
      <div class="flex items-center gap-4">
        <%- include('lang-switcher') %>
        <%- include('theme-toggle') %>
      </div>
    </div>
  </nav>
  <% } %>
  <main class="mx-auto max-w-3xl px-4 py-6 sm:py-8">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="mb-4 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2.5 text-sm text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300"><%= flash %></div>
    <% } %>
