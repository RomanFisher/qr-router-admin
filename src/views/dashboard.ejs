<%- include('partials/header', { title: t('pageTitles.dashboard'), flash }) %>

<h1 class="text-xl font-semibold"><%= t('dashboard.heading') %></h1>

<form method="post" action="/admin/codes" class="mt-4 flex flex-col gap-2 sm:flex-row">
  <input type="text" name="title" placeholder="<%= t('dashboard.newTitlePlaceholder') %>" required
    class="flex-1 rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
  <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500"><%= t('dashboard.create') %></button>
</form>

<% if (codes.length === 0) { %>
  <p class="mt-6 text-sm text-neutral-500 dark:text-neutral-400"><%= t('dashboard.empty') %></p>
<% } %>

<ul class="mt-6 flex flex-col gap-2">
  <% codes.forEach(function(code) { %>
    <li class="flex items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white p-3 dark:border-neutral-800 dark:bg-neutral-900">
      <div class="min-w-0">
        <a href="/admin/codes/<%= code.id %>" class="font-medium text-neutral-900 hover:underline dark:text-neutral-100"><%= code.title %></a>
        <div class="truncate text-xs text-neutral-500 dark:text-neutral-400"><%= baseUrl %>/r/<%= code.slug %></div>
      </div>
      <img src="/admin/codes/<%= code.id %>/qr.png" alt="QR" class="h-12 w-12 flex-shrink-0 rounded border border-neutral-200 bg-white dark:border-neutral-700" />
    </li>
  <% }); %>
</ul>

<%- include('partials/footer') %>
