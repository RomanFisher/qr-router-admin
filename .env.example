# Which port the app is reachable at on the host machine (e.g. http://localhost:3000).
# Change this if 3000 is already taken by something else — the app inside the
# container always keeps listening on 3000 internally, so this is the only
# thing you need to change. See the "Changing the port" section in the README.
HOST_PORT=3000

# Optional: pin the session secret across restarts/rebuilds explicitly.
# If left empty, one is generated automatically on first start and stored
# in ./data/.session_secret — you don't need to set this manually.
# SESSION_SECRET=

# Only needed if you use the HTTPS setup (docker-compose.https.yml + Caddy):
# your real domain name, already pointed at this server's IP via DNS.
# DOMAIN=qr.example.com
